# ─── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_pathshala?schema=public"

# ─── Auth.js (NextAuth v5) ──────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Production canonical URL (set this on Vercel so OAuth redirect URIs match):
#   AUTH_URL="https://me-woad.vercel.app"

# Google OAuth — REQUIRED for the "Continue with Google" button to work.
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#    (Application type: Web application).
# 2) Authorized redirect URIs (add ALL you use):
#      https://me-woad.vercel.app/api/auth/callback/google
#      http://localhost:3000/api/auth/callback/google
# 3) Paste the client ID/secret below (and into Vercel env vars).
# If these are blank, the Google button shows "not configured" and email login is used.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Google Gemini (AI Studio) ──────────────────────────────
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ─── App ────────────────────────────────────────────────────
# Comma-separated emails that get the ADMIN role on sign-up/seed.
ADMIN_EMAILS="salvigaurav278@gmail.com"

# ─── Android (Capacitor) ────────────────────────────────────
# The deployed URL the Android WebView loads (set before `npx cap sync`).
CAP_SERVER_URL="https://me-woad.vercel.app"
# Native Google Sign-In: the Google **Web** client ID (same value as
# AUTH_GOOGLE_ID). Export before `npx cap sync` so it's baked into the app.
GOOGLE_WEB_CLIENT_ID=""
