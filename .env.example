# ─── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_pathshala?schema=public"

# ─── Auth.js (NextAuth v5) ──────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Production canonical URL (set this on Vercel so OAuth redirect URIs match):
#   AUTH_URL="https://read-me-woad.vercel.app"

# Google OAuth — REQUIRED for the "Continue with Google" button to work.
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#    (Application type: Web application).
# 2) Authorized redirect URIs (add ALL you use):
#      https://read-me-woad.vercel.app/api/auth/callback/google
#      http://localhost:3000/api/auth/callback/google
# 3) Paste the client ID/secret below (and into Vercel env vars).
# If these are blank, the Google button shows "not configured" and email login is used.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Google Gemini (AI Studio) ──────────────────────────────
# Create a key at https://aistudio.google.com/apikey
# With a key set, the app ALWAYS uses Gemini (mock is only for local/CI when the
# key is blank). Confirm live via GET /api/ai/status.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Set to "true" to hard-disable mock content: generation fails if no key exists.
AI_REQUIRE_KEY=""

# ─── App ────────────────────────────────────────────────────
# Comma-separated emails that get the ADMIN role on sign-up/seed.
ADMIN_EMAILS="salvigaurav278@gmail.com"

# ─── PDF diagrams (hybrid image system) ─────────────────────
# The offline vector diagram library is always used first. Set this to "true"
# to ALSO fetch public-domain / CC0 / CC BY educational images (Wikimedia
# Commons, Openverse) for concepts with no built-in diagram — cached locally
# and reused. Leave blank/false for a fully offline build. See docs/IMAGES.md.
IMAGE_FETCH_ENABLED=""
# Where fetched images are cached. Point at a persistent volume for a durable
# cache (serverless filesystems are ephemeral). Defaults to assets/diagrams/cache.
IMAGE_CACHE_DIR=""
# Generative AI image fallback (used only when no real licensed image is found).
#   "openai" → needs OPENAI_API_KEY   |   "imagen" → uses GEMINI_API_KEY
#   "auto"   → OpenAI if its key is set, else Imagen   |   "" → disabled
IMAGE_GEN_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"
IMAGEN_MODEL="imagen-3.0-generate-002"

# ─── Android (Capacitor) ────────────────────────────────────
# The deployed URL the Android WebView loads (set before `npx cap sync`).
CAP_SERVER_URL="https://read-me-woad.vercel.app"
# Native Google Sign-In: the Google **Web** client ID (same value as
# AUTH_GOOGLE_ID). Export before `npx cap sync` so it's baked into the app.
GOOGLE_WEB_CLIENT_ID=""
