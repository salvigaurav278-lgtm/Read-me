// Real Pathshala AI — Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Enums ─────────

enum UserRole {
  TEACHER
  ADMIN
}

enum ClassLevel {
  CLASS_10
  CLASS_11
  CLASS_12
  CLASS_6
  CLASS_7
  CLASS_8
  CLASS_9
}

enum Subject {
  MATHEMATICS
  PHYSICS
  CHEMISTRY
  BIOLOGY
  ENGLISH
  BUSINESS_STUDIES
  ECONOMICS
  ACCOUNTANCY
  SCIENCE
  SOCIAL_SCIENCE
  COMPUTER_SCIENCE
  HINDI
  SANSKRIT
}

enum ContentType {
  NOTES
  PPT
  TEST
  WORKSHEET
  DPP
  PYQ
  MIND_MAP
  LESSON_PLAN
  QUESTION_BANK
}

enum ProjectStatus {
  GENERATING
  READY
  FAILED
}

enum ExportFormat {
  PDF
  DOCX
  PPTX
}

// ───────── Auth.js models ─────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(TEACHER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  projects Project[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────── Content models ─────────

model Project {
  id         String        @id @default(cuid())
  userId     String
  title      String
  type       ContentType
  status     ProjectStatus @default(GENERATING)

  classLevel ClassLevel
  subject    Subject
  chapter    String?
  topic      String?

  params  Json? // generation options
  content Json? // structured AI output
  error   String? @db.Text

  saved      Boolean  @default(false)
  tokensUsed Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exports ProjectExport[]

  @@index([userId])
  @@index([type])
  @@index([classLevel, subject])
}

model ProjectExport {
  id        String       @id @default(cuid())
  projectId String
  format    ExportFormat
  fileName  String
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Chapter {
  id         String     @id @default(cuid())
  classLevel ClassLevel
  subject    Subject
  number     Int
  name       String

  @@unique([classLevel, subject, number])
  @@index([classLevel, subject])
}
